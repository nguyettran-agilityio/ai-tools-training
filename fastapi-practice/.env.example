# Copy this file to .env and fill in real values. .env is gitignored.

# Application
APP_NAME="Library Management System"
ENV=dev                    # dev | test | prod
DEBUG=false

# Database
DATABASE_URL=sqlite:///./library.db

# Auth (PyJWT / bcrypt) — JWT_SECRET_KEY is required, no default
# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business rules
BORROW_LIMIT=5
LOAN_DURATION_DAYS=14

# Rate limiting — in-memory, per-process. Guards /auth/login and
# /auth/register against brute-force/spam, keyed by client IP.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Email (SMTP) — optional. Unset SMTP_HOST (the default) falls back to
# InMemoryEmailSender, so dev/test boot without real credentials. To verify
# locally without a real mail provider: `brew install mailpit && mailpit`,
# then SMTP_HOST=localhost / SMTP_PORT=1025 / SMTP_USE_TLS=false — view
# received mail at http://localhost:8025. Real providers (Gmail, SendGrid,
# ...) need SMTP_USE_TLS=true (the default) on port 587.
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@library.local
# SMTP_USE_TLS=true

# CORS — JSON array, not a comma-separated list.
# "*" is fine for local dev only. When ENV=prod this MUST be an explicit list
# of allowed origins (e.g. ["https://app.example.com"]) — Settings raises at
# startup if env=prod and "*" is still present.
CORS_ORIGINS=["*"]

# Seed script (uv run python -m app.cli.seed_admin) — optional. Any of
# these left unset are prompted for interactively instead (password via
# getpass, typed twice). Uncomment to skip prompts, e.g. in CI.
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=admin@123
# ADMIN_FULL_NAME=Admin
